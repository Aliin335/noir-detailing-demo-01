# Copy this file to .env and fill in real values locally. Never commit .env.

# PostgreSQL connection string. Locally, point this at your own Postgres
# instance (e.g. "postgresql://postgres:postgres@localhost:5432/noir_detailing_dev").
# In production (Render), use the "Internal Database URL" from the Render
# Postgres dashboard — same format, same variable, no code changes needed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Single demo admin account for /admin. Generate the hash with:
#   npm run auth:hash-password -- "your-password-here"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Session-signing secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Shared secret for trusted server-to-server callers (e.g. the future n8n
# AI-receptionist workflow) to identify themselves to /api/availability and
# /api/bookings via `Authorization: Bearer <value>`, granting a higher
# rate-limit tier. Optional — if unset, no caller can reach the trusted
# tier and both endpoints keep working exactly as today for the public
# browser widget. Generate with:
#   openssl rand -base64 32
AUTOMATION_API_KEY=
